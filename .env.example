# Application Settings
APP_NAME=Newspaper Ingestion API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True
API_HOST=0.0.0.0
API_PORT=8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/newspaper_db

# Redis
REDIS_URL=redis://localhost:6379/0
# Redis notifications channel
REDIS_NOTIFICATIONS_CHANNEL=vuva:notifications

# Rate Limiting
RATE_LIMIT_FREE_TIER=100
RATE_LIMIT_BASIC_TIER=1000
RATE_LIMIT_PREMIUM_TIER=10000

# OCR Settings
OCR_ENGINE=tesseract
OCR_LANGUAGES=eng
OCR_TIMEOUT_SECONDS=30
MAX_IMAGE_SIZE_MB=10

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# News Sources (Open Source APIs)
NEWS_API_ENABLED=True
RSS_FEEDS_ENABLED=True

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Supabase (optional)
# Set `DATABASE_URL` to the Supabase Postgres connection string. Use the asyncpg prefix
# for async DB access: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# Optional: Supabase Storage credentials for file uploads
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
